# Docker Compose variables (copy to .env). Laravel's own settings live in backend/.env.
UID=1000
GID=1000

APP_PORT=8000
FRONTEND_PORT=5173
DB_FORWARD_PORT=5434

# PostgreSQL (used by the db container AND injected into the Laravel containers)
DB_DATABASE=pc_store
DB_USERNAME=pc_store
DB_PASSWORD=change-me
