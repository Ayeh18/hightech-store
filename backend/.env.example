APP_NAME="PC Custom Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# These must match DB_* in the root .env (scripts/setup.sh keeps them in sync).
# Inside Docker the database host is the compose service name "db".
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pc_store
DB_USERNAME=pc_store
DB_PASSWORD=change-me
# The schema the shop's tables live in. Leave it out ("public") everywhere except Supabase, which publishes "public" as a
# web API: there set DB_SCHEMA=shop. It is created on start-up. See docs/hosting-free.md, part 4.
# DB_SCHEMA=shop

# Sanctum SPA (cookie) authentication: the Vue dev server is the "stateful" origin.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The shop's own clock. Times are stored in UTC; reports group them into days as the shop and its customers see them.
SHOP_TIMEZONE=Asia/Kuala_Lumpur

# Where product photos are kept. "public" = this server's own disk (development). "s3" = any S3-compatible store
# (Cloudflare R2, Backblaze B2, Supabase Storage, AWS S3...), needed on a host whose disk does not survive a restart.
# See docs/hosting-free.md, part 12. To move existing photos across: php artisan shop:copy-images public s3
IMAGE_DISK=public
# Only for IMAGE_DISK=s3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=true
# The bucket's PUBLIC address: photos are shown to customers straight from it.
# AWS_URL=

QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@pc-custom-store.test"
MAIL_FROM_NAME="${APP_NAME}"

# Payment gateway. "fake" is a local simulator (refused in production). Never commit real values.
PAYMENT_PROVIDER=fake
PAYMENT_API_KEY=
PAYMENT_SECRET=
# The secret both sides use to sign webhooks. For the fake gateway any value works; for a real one use the gateway's.
PAYMENT_WEBHOOK_SECRET=local-development-webhook-secret
# Where the fake gateway delivers its webhooks (inside Docker the app is reachable as http://app:8000).
PAYMENT_FAKE_WEBHOOK_URL=http://app:8000/api/webhooks/fake

VITE_APP_NAME="${APP_NAME}"

# Only read on a server, by `php artisan shop:install` (see docs/hosting-free.md): the first admin account, and whether to
# fill an EMPTY catalog with the demo products. Local development uses the demo accounts from the seeders instead.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# SEED_DEMO_CATALOG=false
