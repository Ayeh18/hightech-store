# Keep secrets, dependencies and clutter out of the image.
.env
.env.*
!.env.example
.git
vendor
node_modules
tests
# Uploaded photos and private files belong to the machine they were uploaded on, never to the image.
storage/app/public/*
storage/app/private/*
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
public/storage
phpunit.xml
Dockerfile
.dockerignore
